<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>mame-ao</AssemblyName>
    <RootNamespace>Spludlow.MameAO.Cli</RootNamespace>
    <Version>0.10.0</Version>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.0</FileVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MameAo.Core\MameAo.Core.csproj" />
    <ProjectReference Include="..\MameAo.Platform.Linux\MameAo.Platform.Linux.csproj" />
    <!-- ReferenceOutputAssembly=false: the BitTorrent client is a separate
         program, not a library. The reference only guarantees build order. -->
    <ProjectReference Include="..\MameAo.Bt\MameAo.Bt.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Development convenience: a plain build (not a single-file publish) copies
    the BitTorrent client next to mame-ao so it can be found there. Release
    tarballs embed it instead, and the publish output must stay single-file.
  -->
  <Target Name="CopyDomeBtForDevelopment" AfterTargets="Build"
          Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <DomeBtDevelopmentBinary Include="$(MSBuildThisFileDirectory)../MameAo.Bt/bin/$(Configuration)/$(TargetFramework)/dome-bt" />
    </ItemGroup>
    <Copy SourceFiles="@(DomeBtDevelopmentBinary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('@(DomeBtDevelopmentBinary)')" />
  </Target>

  <!--
    Release builds pass -p:DomeBtBinary=<published dome-bt> so the tarball is a
    single executable. Development builds without it simply report that
    BitTorrent is unavailable.
  -->
  <ItemGroup Condition="'$(DomeBtBinary)' != '' and Exists('$(DomeBtBinary)')">
    <EmbeddedResource Include="$(DomeBtBinary)" LogicalName="dome-bt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="UI.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
